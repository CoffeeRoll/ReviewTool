<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReviewTool.Server</RootNamespace>
    <WebUiDir>$(MSBuildProjectDirectory)/../ReviewTool.Web</WebUiDir>
    <!-- Set to false (dotnet build -p:BuildWebUi=false) to skip building the React UI. -->
    <BuildWebUi Condition="'$(BuildWebUi)' == ''">true</BuildWebUi>
  </PropertyGroup>

  <!-- Packaged as a .NET tool: `dotnet tool install -g ReviewTool`, then run `reviewtool` in a repo. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>reviewtool</ToolCommandName>
    <PackageId>ReviewTool</PackageId>
    <Version>0.3.0</Version>
    <Authors>ReviewTool contributors</Authors>
    <Description>Review a git branch or pull request one commit at a time, with line notes, saved progress and side-by-side panes.</Description>
    <PackageTags>git;code-review;pull-request;review;dotnet-tool</PackageTags>
    <PackageOutputPath>$(MSBuildProjectDirectory)/../../artifacts/nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReviewTool.Core\ReviewTool.Core.csproj" />
  </ItemGroup>

  <!--
    First build: if the UI has never been built, run npm so `dotnet run` works out of the box.
    After changing UI code, run `npm run build` in src/ReviewTool.Web (or use `npm run dev`).
  -->
  <Target Name="BuildWebUiIfMissing" BeforeTargets="Build" Condition="'$(BuildWebUi)' == 'true' And !Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')">
    <Message Importance="high" Text="ReviewTool: building the web UI (npm install + npm run build)..." />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(WebUiDir)" Condition="!Exists('$(WebUiDir)/node_modules')" ContinueOnError="true" />
    <Exec Command="npm run build" WorkingDirectory="$(WebUiDir)" ContinueOnError="true" />
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')" Text="The web UI could not be built. Install Node.js 20+ and run 'npm install &amp;&amp; npm run build' in src/ReviewTool.Web." />
  </Target>

  <!--
    Publish/pack: make sure the built UI is in the output. If wwwroot didn't exist when the project was
    evaluated (fresh clone), the static-asset pipeline missed it, so add the files here.
    For a fresh UI build before packing, run scripts/install-tool.sh (or `npm run build` first).
  -->
  <Target Name="PublishWebUi" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_PublishedWebUi Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('wwwroot/'))" />
      <_WebUiFiles Include="$(MSBuildProjectDirectory)/wwwroot/**" Condition="'@(_PublishedWebUi)' == ''" />
      <ResolvedFileToPublish Include="@(_WebUiFiles)">
        <RelativePath>wwwroot/%(_WebUiFiles.RecursiveDir)%(_WebUiFiles.Filename)%(_WebUiFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Warning Condition="'@(_PublishedWebUi)' == '' And '@(_WebUiFiles)' == ''" Text="The web UI is missing from the output. Run 'npm ci &amp;&amp; npm run build' in src/ReviewTool.Web first." />
  </Target>

</Project>
